generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  VIEWER
}

enum AuthType {
  BASIC
}

enum CollectorScope {
  GENERAL
  CLIENT
  INSTANCE
}

enum CollectorStatus {
  RUNNING
  SUCCESS
  FAILED
  PARTIAL
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model User {
  id           String         @id @default(cuid())
  name         String
  email        String         @unique
  passwordHash String
  role         UserRole       @default(VIEWER)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  collectorRuns CollectorRun[]

  @@map("users")
}

model Client {
  id          String                  @id @default(cuid())
  name        String
  description String?
  active      Boolean                 @default(true)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  instances   ServiceNowInstance[]
  snapshots   LicenseWeeklySnapshot[]
  collectorRuns CollectorRun[]

  @@map("clients")
}

model ServiceNowInstance {
  id                String                  @id @default(cuid())
  clientId          String
  client            Client                  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name              String
  baseUrl           String
  environment       String?
  active            Boolean                 @default(true)
  authType          AuthType                @default(BASIC)
  username          String?
  encryptedPassword String?
  encryptedToken    String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  snapshots         LicenseWeeklySnapshot[]
  collectorRuns     CollectorRun[]

  @@unique([clientId, name])
  @@index([clientId, active])
  @@map("servicenow_instances")
}

model LicenseWeeklySnapshot {
  id                       String             @id @default(cuid())
  clientId                 String
  client                   Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  instanceId               String
  instance                 ServiceNowInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  collectedAt              DateTime
  weekReference            String
  overviewSysId            String             @default("")
  subscriptionSysId        String             @default("")
  entitlementSysId         String             @default("")
  licenseSysId             String             @default("")
  productCode              String
  licenseName              String?
  entitlementName          String?
  meterType                String?
  unitOfMeter              String?
  entitlementId            String?
  parentEntitlementId      String?
  purchasedCount           Float?
  allocatedCount           Float?
  availableCount           Float?
  usagePercent             Float?
  overviewStatus           String?
  overviewSubscriptionType String?
  licenseCount             Float?
  licenseAllocated         Float?
  licenseAvailable         Float?
  licenseUsagePercent      Float?
  allocatedStatus          String?
  licenseType              String?
  licenseCategory          String?
  licenseWeight            Float?
  tableCount               Float?
  tablesUsed               Float?
  startDate                DateTime?
  endDate                  DateTime?
  daysToExpire             Int?
  expired                  Boolean            @default(false)
  displayOnly              Boolean            @default(false)
  isCapped                 Boolean            @default(false)
  autoSync                 Boolean            @default(false)
  riskLevel                RiskLevel           @default(LOW)
  riskReason               String?
  rawOverview              Json
  rawEntitlement           Json?
  rawLicenseDetails        Json?
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt

  @@unique([instanceId, weekReference, productCode, licenseSysId, subscriptionSysId], name: "snapshot_week_unique")
  @@index([clientId, weekReference])
  @@index([instanceId, weekReference])
  @@index([riskLevel])
  @@map("license_weekly_snapshots")
}

model CollectorRun {
  id              String              @id @default(cuid())
  clientId        String?
  client          Client?             @relation(fields: [clientId], references: [id], onDelete: SetNull)
  instanceId      String?
  instance        ServiceNowInstance? @relation(fields: [instanceId], references: [id], onDelete: SetNull)
  scope           CollectorScope
  status          CollectorStatus     @default(RUNNING)
  startedAt       DateTime            @default(now())
  finishedAt      DateTime?
  totalInstances  Int                 @default(0)
  totalSuccess    Int                 @default(0)
  totalFailed     Int                 @default(0)
  totalSnapshots  Int                 @default(0)
  errorMessage    String?
  createdByUserId String?
  createdByUser   User?               @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([scope, startedAt])
  @@index([clientId, startedAt])
  @@index([instanceId, startedAt])
  @@map("collector_runs")
}
